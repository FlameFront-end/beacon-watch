DB_HOST=localhost
DB_PORT=5432
DB_USER=beaconwatch
DB_PASS=replace-with-a-long-random-password
DB_NAME=beaconwatch
PORT=3010
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
AUTH_SESSION_SECRET=replace-with-a-long-random-secret
AUTH_SESSION_TTL_SECONDS=86400
AUTH_COOKIE_SECURE=true
SMTP_HOST=localhost
SMTP_PORT=25
# true enables implicit TLS, usually on port 465.
SMTP_SECURE=false
# true requires STARTTLS. Do not enable together with SMTP_SECURE.
SMTP_REQUIRE_TLS=false
SMTP_FROM=beaconwatch@beaconwatch.local
# Set both values for authenticated SMTP; leave them empty for an anonymous relay.
SMTP_USER=
SMTP_PASSWORD=
SMTP_TIMEOUT_MS=10000
SMTP_SETTINGS_ENCRYPTION_KEY=replace-with-an-independent-long-random-secret

SMTP_SOCKS5_HOST=
SMTP_SOCKS5_PORT=1080
SMTP_SOCKS5_USER=
SMTP_SOCKS5_PASSWORD=
DELIVERY_AGENT_SECRET=replace-with-a-long-independent-agent-secret
SMTP_DELIVERY_RETENTION_DAYS=90
SMTP_DELIVERY_ERROR_RETENTION_DAYS=180

# Public callback receiver
CALLBACK_RATE_LIMIT_MAX=120
CALLBACK_RATE_LIMIT_WINDOW_MS=60000
CALLBACK_RETENTION_DAYS=30

# Leave empty for the same-origin UI. Otherwise use a comma-separated allowlist.
CORS_ORIGINS=
VITE_API_URL=

# Vulnerability monitoring (see docs/vulnerability-monitoring.md)
VULN_MONITORING_ENABLED=false
VULN_NVD_ENABLED=true
VULN_GITHUB_ENABLED=true
VULN_CISA_KEV_ENABLED=true

# Optional: raises NVD rate limits. Get a key at https://nvd.nist.gov/developers/request-an-api-key
VULN_NVD_API_KEY=
# Required for the GitHub Advisories source; a fine-grained PAT with no extra scopes is enough for public advisories.
VULN_GITHUB_TOKEN=

VULN_NVD_CRON=*/15 * * * *
VULN_GITHUB_CRON=*/10 * * * *
VULN_CISA_KEV_CRON=0 * * * *
VULN_EXPLOIT_ENRICHMENT_ENABLED=true
VULN_EXPLOIT_ENRICHMENT_CRON=*/30 * * * *
VULN_EXPLOIT_GITHUB_BATCH_SIZE=10
VULN_EXPLOIT_GITHUB_RESULT_LIMIT=10
VULN_EXPLOIT_LOOKUP_COOLDOWN_HOURS=24
VULN_EXPLOIT_CANDIDATE_LIMIT=500
VULN_EXPLOIT_DB_URL=https://gitlab.com/exploit-database/exploitdb/-/raw/main/files_exploits.csv

# Page ceilings per sync run. A 30-day NVD window is roughly three 2000-record pages, so the
# default leaves headroom while stopping an anomalous walk from outliving the source lease.
# Reaching a ceiling is reported on the collection run and the cursor is kept for the next run.
VULN_NVD_MAX_PAGES=15
VULN_CISA_KEV_MAX_PAGES=1
# Rows read per batch when re-normalizing stored payloads after a normalizer change.
VULN_RENORMALIZATION_BATCH_SIZE=200

VULN_SOURCE_TIMEOUT_MS=15000
VULN_NVD_TIMEOUT_MS=60000
VULN_SOURCE_MAX_RETRIES=3
VULN_DEFAULT_MIN_SCORE=60
VULN_NOTIFICATION_MIN_SCORE=70
VULN_RCE_NOTIFICATION_RULES_ENABLED=false
VULN_MAX_CVE_AGE_DAYS=30
